  }, {
    "name" : "delivery",
    "description" : "Delivery Operations"
  }, {
    "name" : "crop registration",
    "description" : "Registration Operations"
  } ],
  "paths" : {
    "/growers" : {
      "get" : {
        "tags" : [ "parties" ],
        "summary" : "get all growers",
        "operationId" : "get-growers",
        "description" : "Returns all growers for which caller is autorised\n",
        "parameters" : [ {
          "in" : "query",
          "name" : "offset",
          "description" : "number of records to skip for pagination",
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 0
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "description" : "maximum number of records to return",
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 0,
            "maximum" : 50
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Shared Response",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/grower"
                  }
                }
              }
            }
          },
          "400" : {
            "$ref" : "#/components/responses/default_error"
          },
          "401" : {
            "$ref" : "#/components/responses/default_error"
          },
          "5XX" : {
            "$ref" : "#/components/responses/default_error"
          },
          "default" : {
            "description" : "Default",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
