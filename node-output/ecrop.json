  "components" : {
    "schemas" : {
      "dataschema" : {
        "$ref" : "./openapi-schema.json"
      },
      "version" : {
        "type" : "object",
        "additionalProperties" : false,
        "description" : "Version of the API based on semver notation",
        "required" : [ "major", "minor", "patch" ],
        "properties" : {
          "major" : {
            "type" : "integer",
            "description" : "Major.",
            "format" : "int32"
          },
          "minor" : {
            "type" : "integer",
            "description" : "Minor.",
            "format" : "int32"
          },
          "patch" : {
            "type" : "integer",
            "description" : "Patch.",
            "format" : "int32"
          }
        }
      },
      "error" : {
        "type" : "object",
        "required" : [ "type", "title", "status" ],
        "properties" : {
          "type" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "detail" : {
            "type" : "string",
            "nullable" : true
          },
          "instance" : {
            "type" : "string",
            "nullable" : true
          }
        },
        "description" : ""
      },
      "identifier" : {
        "required" : [ "id", "schemaIdType" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "minLength" : 1,
            "type" : "string",
            "description" : "Identifier value.",
            "default" : "12345"
          },
          "schemaIdType" : {
            "minLength" : 1,
            "type" : "string",
            "description" : "Schema type.",
            "default" : "MPS"
          }
        },
        "additionalProperties" : false,
        "description" : "Representation of an identifier."
      },
      "measurementtype" : {
        "title" : "measurementtype",
        "type" : "object",
        "description" : "Standard data type for expressing the value of a measurement. To be used for all types of measurement in this class model.",
        "properties" : {
          "value" : {
            "type" : "number",
            "format" : "float",
            "description" : "Expresses the measured value of the measurement."
          },
          "unitcode" : {
            "type" : "string",
            "x-stoplight" : {
              "id" : "kilal7v7ybauf"
            },
            "description" : "The code that refers to the standard unit or dimension to express the value of this measurement. E.g. KGM for kilogram.\r\nCode list Id: nl.cl020"
          }
        }
      },
      "characteristic" : {
        "title" : "characteristic",
        "type" : "object",
        "description" : "Generic data type for linked characteristics to a crop, task, operation, allocation, etc.",
        "properties" : {
          "codelistid" : {
            "type" : "string",
            "description" : "Identifier of the code list that contains the coding of characteristics for a specific domain:\r\n\r\nFor instance:\r\nThe code list id for crop and operations characteristics for arable farming is NL_CL265."
          },
          "value" : {
            "$ref" : "#/components/schemas/measurementtype"
          },
          "issuedate" : {
            "type" : "string",
            "x-stoplight" : {
              "id" : "r7foutm9h9b3c"
            },
            "description" : "The data the characteristic was captured.\r\n",
            "format" : "date"
          },
          "startdate" : {
            "type" : "string",
            "x-stoplight" : {
              "id" : "97hif3dvffq1e"
            },
            "format" : "date",
            "description" : "Begin data of the period this characteristic is or was valid.\r\n"
          },
          "einddate" : {
            "type" : "string",
            "x-stoplight" : {
              "id" : "hkbnpja2afbri"
            },
            "format" : "date",
            "description" : "End data of the period this characteristic is or was valid."
          }
        }
      },
      "party" : {
        "type" : "object",
        "title" : "Party",
        "required" : [ "id", "name", "personName" ],
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid",
            "example" : "d290f1ee-6c54-4b01-90e6-d701748f0851"
          },
          "partyId" : {
            "$ref" : "#/components/schemas/identifier"
          },
          "name" : {
            "type" : "string",
            "example" : "VOF De Lier"
          },
          "personName" : {
            "type" : "string",
            "example" : "J. de Lier"
          }
        }
      },
      "grower" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/party"
        }, {
          "type" : "object",
          "properties" : {
            "grownerName" : {
              "type" : "string"
            }
          },
          "required" : [ "growerName" ]
        } ]
      },
      "supplier" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/party"
        }, {
          "type" : "object",
          "properties" : {
            "supplierName" : {
              "type" : "string"
            }
          },
          "required" : [ "supplierName" ]
        } ]
      },
      "asset" : {
        "title" : "asset",
        "type" : "object",
        "description" : "Entity of a tangible object on which operations can be performed.\nE.g.: a crop, a building, a machine, a ditch, a greenhouse, a climate control system, a feeding system, etc.",
        "required" : [ "id", "name" ],
        "properties" : {
          "id" : {
            "type" : "string",
            "description" : "Identifier of the asset."
          },
          "name" : {
            "type" : "string",
            "x-stoplight" : {
              "id" : "rg34jp6i0ornr"
            }
          },
          "startDate" : {
            "type" : "string",
            "x-stoplight" : {
              "id" : "b0fsf0o9mvd54"
            },
            "format" : "date"
          },
          "endDate" : {
            "type" : "string",
            "x-stoplight" : {
              "id" : "q8mkecxxqjg37"
            },
            "format" : "date"
          },
          "characteristics" : {
            "type" : "array",
            "x-stoplight" : {
              "id" : "fmi4cfqq7u0de"
            },
            "items" : {
              "$ref" : "#/components/schemas/characteristic"
            }
          }
        }
      },
      "crop" : {
        "title" : "crop",
        "description" : "The cultivation of a specific crop type (e.g. potato, wheat, rice,. etc.) on one or more plots during a specific period of time, specified by startDateTime and endDateTime.",
        "allOf" : [ {
          "$ref" : "#/components/schemas/asset"
        }, {
          "type" : "object",
          "required" : [ "year" ],
          "properties" : {
            "year" : {
              "type" : "integer",
              "format" : "int32",
              "description" : "Indication of the year in which the cultivation is harvested."
            },
            "country" : {
              "type" : "string",
              "x-stoplight" : {
                "id" : "08swed8u1a95w"
              },
              "description" : "Code list: ISO country code: 2 letter ISO 3166."
            },
            "region" : {
              "type" : "string",
              "x-stoplight" : {
                "id" : "035xhjjhxcan9"
              },
              "description" : "Region of a country the cultivation took place.\\nFor eCrop in The Netherlands for this code list code list NL.CL044 is used."
            },
            "useTitle" : {
              "type" : "string",
              "x-stoplight" : {
                "id" : "j1vyfe82lser2"
              },
              "description" : "Code to indicate the type of legal ownership of the field that is used for the cultivation.\\nFor eCrop in The Netherlands code list nl.cl412 is used for this."
            },
            "productinType" : {
              "type" : "string",
              "x-stoplight" : {
                "id" : "kc7hwstxuzvyx"
              },
              "description" : "Indicates the intensity of the cultivation.\\nIn The Netherlands used to report to the MLNV-RVO authority.\\nCode list: nl.cl255"
            },
            "productionPurpose" : {
              "type" : "string",
              "x-stoplight" : {
                "id" : "db1ods23qgkej"
              },
              "description" : "Indicator of the produce purpose the cultivation.\\nFor instance: fresh marked, animal feed, seed production, etc.\\nCode list: nl.cl251"
            },
            "productionSequence" : {
              "type" : "string",
              "x-stoplight" : {
                "id" : "65jb1i0wfyhff"
              },
              "description" : "ndicates if and how the cultivation is combines to other cultivations. \\nEnumeration: PRE_CROP = voorteelt, MAIN_CROP = hoofdteelt, FOLLOWUP_CROP = volgteelt, MIXED_CROP = mengteelt"
            },
            "regularOrOrganic" : {
              "type" : "string",
              "x-stoplight" : {
                "id" : "qgh8ua5czka5p"
              },
              "description" : "Production protocol: indicates whether this cultivation is classified as grown organic or non-organic.\\nCode list: nl.cl015"
            },
            "netArea" : {
              "type" : "string",
              "x-stoplight" : {
                "id" : "z2tlht2ifs8ai"
              },
              "description" : "The net (netto) area (in m2, hectare, etc.) of the surface that is used for this cultivation."
            },
            "growEnvironment" : {
              "type" : "string",
              "x-stoplight" : {
                "id" : "nh7mr3ddc1idu"
              },
              "description" : "Indicates in what type of environment this cultivation took place, e.g. in the open air, in a greenhouse, etc.\\nCode list: nl.cl299"
            },
            "growMedium" : {
              "type" : "string",
              "x-stoplight" : {
                "id" : "amnbdzr28xcij"
              },
              "description" : "Indicates in what medium the cultivation is rooted; for instance in soil, in substrate, on bark, etc.\\nCode list: nl.cl300"
            },
            "trackTillage" : {
              "type" : "boolean",
              "x-stoplight" : {
                "id" : "595zekiefw8g6"
              },
              "description" : "Indicates whether the cultivation, over the years, is done in fixed lanes with fixed tracks for machinery.\\n\\nyes = track tillage is applied\\nno = track tillage is not applied"
            },
            "plantSpecies" : {
              "x-stoplight" : {
                "id" : "8kpqgpnhf9xw2"
              },
              "type" : "array",
              "items" : {
                "$ref" : "#/components/schemas/plantspecies"
              }
            }
          }
        } ]
      },
      "plantspecies" : {
        "title" : "plantspecies",
